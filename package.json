{
  "name": "hrms-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Brand Human Resource Management System (HRMS) MVP",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n \"API,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run prisma:seed",
    "db:push": "npm --prefix server run prisma:push"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
